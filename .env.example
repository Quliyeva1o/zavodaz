# Copy to .env.local for development. Never commit real values.
SITE_URL=http://localhost:3000
# Test copies (new.zavod.az) must never be indexed. Dev/e2e builds are always noindex (=1);
# production sets it per environment in shared/.env (empty on the real site).
SITE_NOINDEX=1
DATABASE_URL=postgres://zavod:zavod@localhost:5442/zavod
# First admin, created by `npm run db:seed-admin` (password ≥ 12 chars)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Salt for hashing visitor IPs (rate limits). `openssl rand -hex 32`
IP_HASH_SALT=
# Visitor IP source: default trusts the LAST X-Forwarded-For entry (added by our server). Set to first-forwarded only behind a proxy that overwrites the header
CLIENT_IP_FROM=
# Figma REST API token (file_content:read) — design export scripts only
FIGMA_TOKEN=
FIGMA_FILE_KEY=iLz9wZPvZmcyxEWRKjMY4m
