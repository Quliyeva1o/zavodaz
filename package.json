{
  "name": "zavod-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed-admin": "node --env-file-if-exists=.env.local --import tsx scripts/seed/admin.mts",
    "db:seed-content": "node --env-file-if-exists=.env.local --import tsx scripts/seed/content.mts",
    "figma:inspect": "node --env-file-if-exists=.env.local --import tsx scripts/figma/inspect.mts",
    "figma:tokens": "node --env-file-if-exists=.env.local --import tsx scripts/figma/export-tokens.mts",
    "figma:assets": "node --env-file-if-exists=.env.local --import tsx scripts/figma/export-assets.mts",
    "figma:icons": "node --env-file-if-exists=.env.local --import tsx scripts/figma/export-icons.mts",
    "figma:references": "node --env-file-if-exists=.env.local --import tsx scripts/figma/export-references.mts",
    "visual:capture": "node tests/visual/capture.mjs",
    "visual:geometry": "node --env-file-if-exists=.env.local --import tsx tests/visual/geometry.mjs",
    "visual:compare": "node tests/visual/compare.mjs",
    "visual:check": "npm run visual:capture && npm run visual:geometry && npm run visual:compare"
  },
  "dependencies": {
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "nodemailer": "^10.6.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
