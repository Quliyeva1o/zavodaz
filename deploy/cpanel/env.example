# Production settings for the cPanel account → copy to ~/zavod-app/shared/.env
# (chmod 600). Never commit the filled-in file. One KEY=value per line; quote values
# that contain spaces.
#
# SITE_URL and SITE_NOINDEX are read at BUILD time (deploy.sh links this file as .env.local
# before building) — change them, then run deploy.sh again.

# Test copy. For the real site use https://zavod.az and remove SITE_NOINDEX.
SITE_URL=https://new.zavod.az
# 1 = robots.txt disallows all + X-Robots-Tag noindex.
SITE_NOINDEX=1

# PostgreSQL database created in cPanel → PostgreSQL Databases (names get the
# account prefix, e.g. <account>_zavod). Special characters in the password must be
# URL-encoded (@ → %40, # → %23, / → %2F, : → %3A).
DATABASE_URL=postgres://<account>_zavodapp:<password>@localhost:5432/<account>_zavod

# REQUIRED in production: the app refuses to start without it (and without SITE_URL / DATABASE_URL).
# At least 32 characters (`openssl rand -hex 32`) — salts the hashed visitor IPs.
IP_HASH_SALT=

# Uploaded images. Must be OUTSIDE the release folder so deploys never delete it.
# app.js defaults it to ~/zavod-app/shared/uploads; set another absolute path (e.g. /home/<account>/zavod-uploads) to override.
UPLOAD_DIR=

# Visitor IP source: by default the app trusts the LAST X-Forwarded-For entry (LiteSpeed
# appends the visitor's address there). Leave empty; "first-forwarded" only behind a proxy
# that overwrites the header.
# CLIENT_IP_FROM=

# First admin account (`npm run db:seed-admin` in ~/zavod-src). Password ≥ 12 chars.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Outgoing mail (contact form notifications; recipients are set in the admin panel).
# cPanel → Email Accounts: create noreply@zavod.az; "Connect Devices" shows the SMTP server.
# Port 465 = SSL. Empty SMTP_HOST = mails are skipped (the message is still saved in the admin panel).
SMTP_HOST=mail.zavod.az
SMTP_PORT=465
SMTP_USER=noreply@zavod.az
SMTP_PASS=
SMTP_FROM="Zavod.az <noreply@zavod.az>"
